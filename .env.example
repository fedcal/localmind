# ==================================================
# LocalMind - Variabili d'Ambiente (Template)
# Copia questo file in .env e personalizza i valori.
#
# LocalMind - Environment Variables (Template)
# Copy this file to .env and customize the values.
# ==================================================

# --- Database MySQL ---
# Host: 'localhost' per modalita' nativa, 'mysql' per Docker completo
# Host: 'localhost' for native mode, 'mysql' for full Docker mode
DB_HOST=localhost
DB_PORT=3306
DB_NAME=localmind
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080

# --- Ollama (LLM locale / Local LLM) ---
# Host: 'localhost' per modalita' nativa, 'ollama' per Docker completo
# Host: 'localhost' for native mode, 'ollama' for full Docker mode
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM Provider ---
# Provider predefinito / Default provider: OLLAMA, OPENAI, ANTHROPIC, GOOGLE
LLM_DEFAULT_PROVIDER=OLLAMA
LLM_OLLAMA_ENABLED=true
LLM_OPENAI_ENABLED=false
LLM_ANTHROPIC_ENABLED=false
LLM_GOOGLE_ENABLED=false

# --- API Keys (opzionali, lasciare vuoti per modalita' solo locale) ---
# --- API Keys (optional, leave empty for local-only mode) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=

# --- Qdrant (Vector Store) ---
# Host: 'localhost' per modalita' nativa, 'qdrant' per Docker completo
# Host: 'localhost' for native mode, 'qdrant' for full Docker mode
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=localmind-documents

# --- n8n (Automazioni / Automations) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# --- Documenti / Documents ---
DOCUMENT_UPLOAD_DIR=~/.localmind/uploads
MAX_FILE_SIZE=50MB

# --- Calendario / Calendar (CalDAV) ---
CALENDAR_ENABLED=false
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# --- Email (IMAP/SMTP) ---
EMAIL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- Maven Central (Sonatype Central Portal) ---
# Token generato da: https://central.sonatype.com → View User Tokens
# Token generated from: https://central.sonatype.com → View User Tokens
CENTRAL_USERNAME=
CENTRAL_TOKEN=
