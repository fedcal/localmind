# ==================================================
# LocalMind - Variabili d'Ambiente (Template)
# Copia questo file in .env e personalizza i valori.
# ==================================================

# --- Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=localmind
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080

# --- Ollama (LLM locale) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM Provider ---
LLM_DEFAULT_PROVIDER=OLLAMA
LLM_OLLAMA_ENABLED=true
LLM_OPENAI_ENABLED=false
LLM_ANTHROPIC_ENABLED=false
LLM_GOOGLE_ENABLED=false

# --- API Keys (opzionali, lasciare vuoti per modalita' solo locale) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=

# --- Qdrant (Vector Store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=localmind-documents

# --- n8n (Automazioni) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=localmind

# --- Documenti ---
DOCUMENT_UPLOAD_DIR=~/.localmind/uploads
MAX_FILE_SIZE=50MB
