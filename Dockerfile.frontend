# ==========================================================
# LocalMind Frontend - Dockerfile
# Multi-stage build: Node 22 → Nginx Alpine
# ==========================================================

# --- Stage 1: Build ---
FROM node:22-alpine AS builder

WORKDIR /build

# Copia package files per cache dipendenze
# Copy package files for dependency caching
COPY localmind-frontend/package.json localmind-frontend/package-lock.json ./

# Installa dipendenze / Install dependencies
RUN npm ci

# Copia sorgenti / Copy sources
COPY localmind-frontend/ ./

# Build produzione / Production build
RUN npm run build -- --configuration production

# --- Stage 2: Serve ---
FROM nginx:alpine

# Metadata
LABEL maintainer="LocalMind" \
      description="LocalMind Frontend - Angular 21 + Nginx" \
      version="0.1.0"

# Rimuovi config di default / Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copia config Nginx / Copy Nginx config
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copia build Angular / Copy Angular build
# Angular 21 con @angular/build:application produce in dist/<project>/browser/
COPY --from=builder /build/dist/localmind-frontend/browser/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
